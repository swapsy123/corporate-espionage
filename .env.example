# Documentation only. These placeholders are not usable credentials.
# Set real values through the hosting service's secret/environment settings.
OWNER_EMAIL=fraser@wearelevr.com
LEVR_OWNER_PASSWORD=
# Levr workspace only; client workspaces configure their own keys in Settings.
SCRAPECREATORS_API_KEY=

# Render generates this secret on blueprint sync. For local development, inject
# a unique random value of at least 32 characters through secure settings.
# Keep it stable: replacing it prevents decryption of existing client keys.
LEVR_SECRET_ENCRYPTION_KEY=

# Optional richer original adaptations through OpenAI. Never prefix with VITE_.
LEVR_AI_API_KEY=

# Node 24; local development. Render overrides these values.
NODE_ENV=development
PORT=3000
# Render terminates HTTPS behind one trusted proxy; leave unset locally.
# TRUST_PROXY=1
DATABASE_PATH=./data/levr.sqlite
